config {
    type: "view",
    name: "radar_metrics_wingers_season",
    description: "Season averages and percentiles for wingers statistics",
    schema: "analytics",
    tags:["radar", "season"]
}
WITH season_stats AS (
    SELECT 
        player_id,
        season_id,
        SUM(minutes_played) AS total_minutes_played,

        -- Weighted metrics per 90
        SUM(successful_take_ons * minutes_played) / SUM(minutes_played) * 90 AS avg_successful_take_ons,
        SUM(crosses * minutes_played) / SUM(minutes_played) * 90 AS avg_crosses,
        SUM(shots * minutes_played) / SUM(minutes_played) * 90 AS avg_shots,
        SUM(progressive_carries * minutes_played) / SUM(minutes_played) * 90 AS avg_progressive_carries,
        SUM(goal_creating_actions * minutes_played) / SUM(minutes_played) * 90 AS avg_goal_creating_actions,
        SUM(non_penalty_xg * minutes_played) / SUM(minutes_played) * 90 AS avg_non_penalty_xg,
        -- Straight average for aerial duels won rate
        AVG(aerial_duels_won_rate) AS avg_aerial_duels_won_rate
    FROM 
        ${ref("radar_metrics_wingers")}
    GROUP BY 
        player_id, season_id
),
percentiles AS (
    SELECT
        player_id,
        season_id,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_successful_take_ons) AS successful_take_ons_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_crosses) AS crosses_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_shots) AS shots_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_progressive_carries) AS progressive_carries_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_aerial_duels_won_rate) AS aerial_duels_won_rate_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_goal_creating_actions) AS goal_creating_actions_percentile,
        PERCENT_RANK() OVER(PARTITION BY season_id ORDER BY avg_non_penalty_xg) AS non_penalty_xg_percentile
    FROM 
        season_stats
)
SELECT 
    s.player_id,
    s.season_id,
    s.total_minutes_played,
    s.avg_successful_take_ons,
    s.avg_crosses,
    s.avg_shots,
    s.avg_progressive_carries,
    s.avg_aerial_duels_won_rate,
    s.avg_goal_creating_actions,
    s.avg_non_penalty_xg,
    
    p.successful_take_ons_percentile,
    p.crosses_percentile,
    p.shots_percentile,
    p.progressive_carries_percentile,
    p.aerial_duels_won_rate_percentile,
    p.goal_creating_actions_percentile,
    p.non_penalty_xg_percentile
FROM 
    season_stats s
JOIN 
    percentiles p
USING (player_id, season_id)