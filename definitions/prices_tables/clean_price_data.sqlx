config {
  type: "table",
  schema: "football_data",
  name: "clean_price_data"
}

SELECT
    CAST(id as int) as player_id,
    name as player_name,
    position,
    DATE(dateOfBirth) as birth_date,
    height,
    foot,
    marketValue,
    club_name,
    DATETIME(mv_updated_at) as last_price_update

FROM ${ref("player_data")}