config {
  type: "incremental",
  name: "dim_seasons",
  schema: "analytics",
  description: "Defines seasons.",
  uniqueKey: ["season_id"]
}

SELECT DISTINCT
    REPLACE(season, '/', '') AS season_id,
    season as season_name
FROM ${ref("clean_injuries_data")}
${
    when(incremental(),
    `
    WHERE NOT EXISTS (
        SELECT 1 
        FROM ${self()} t
        WHERE t.season_id = season_id
    )`)
}
