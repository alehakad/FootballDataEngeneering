config {
    type: "incremental",
    name: "dim_teams",
    description: "Dimension table for team",
    uniqueKey: ["team_id"],
    schema: "analytics"
}
SELECT DISTINCT
    id as team_id,
    name as team_name
FROM 
    ${ref("club_data")}
${ when(incremental(), 
    `WHERE
    id NOT IN (
    SELECT team_id 
    FROM ${self()})`,
    )
}